{
  "name": "node-red-industrial-render",
  "version": "1.1.0",
  "private": true,
  "description": "Node-RED 5.0.10 runtime for industrial automation: OPC UA, Modbus TCP, Siemens S7 and FlowFuse Dashboard, deployed with Docker on Render.",
  "license": "UNLICENSED",
  "main": "node_modules/node-red/red.js",
  "scripts": {
    "start": "node-red --userDir /data --settings ./settings.js --port ${PORT:-1880}",
    "test": "node test/smoke.js",
    "check:runtime": "node -e \"const p=require('node-red/package.json'); console.log('Node-RED',p.version)\"",
    "check:nodes": "node -e \"for (const p of ['node-red-contrib-opcua','node-red-contrib-modbus','node-red-contrib-s7','@flowfuse/node-red-dashboard']) { console.log(p, require(p + '/package.json').version) }\""
  },
  "engines": {
    "node": ">=22.9.0 <23",
    "npm": ">=10"
  },
  "dependencies": {
    "@flowfuse/node-red-dashboard": "1.37.0",
    "node-red": "5.0.10",
    "node-red-contrib-modbus": "5.62.1",
    "node-red-contrib-opcua": "0.2.355",
    "node-red-contrib-s7": "3.1.3"
  }
}
